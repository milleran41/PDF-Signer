{
  "manifest_version": 3,
  "name": "BRINO — заполнение и подпись бланков",
  "version": "1.0.0",
  "description": "Заполняйте PDF, DOCX и изображения: добавляйте текст и подпись поверх документа без изменения исходного файла.",
  "permissions": ["clipboardRead"],
  "action": {
    "default_title": "BRINO",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["editor.html"], "matches": ["<all_urls>"] }
  ],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}

