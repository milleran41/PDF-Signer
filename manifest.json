{
  "manifest_version": 3,
  "name": "BRINO — заполнение и подпись бланков",
  "version": "1.0.0",
  "description": "Заполняйте PDF, DOCX и изображения: добавляйте текст и подпись поверх документа без изменения исходного файла.",
  "permissions": ["storage", "activeTab", "downloads", "clipboardRead", "nativeMessaging"],
  "action": {
    "default_title": "BRINO",
    "default_icon": "icon.png"
  },
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["editor.html"], "matches": ["<all_urls>"] }
  ],
  "icons": { "48": "icon.png", "128": "icon.png" }
}

